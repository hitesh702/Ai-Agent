generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum AgentLanguage {
  HINGLISH
  HINDI
  ENGLISH
}

enum LeadStatus {
  NEW
  CALLING
  COMPLETED
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP
  NO_RESPONSE
  CONVERTED
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  ENDED
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum CampaignLeadStatus {
  PENDING
  CALLING
  COMPLETED
  SKIPPED
  FAILED
}

enum FollowUpStatus {
  PENDING
  READY
  QUEUED
  COMPLETED
  CANCELLED
  SKIPPED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// --- Core entities ---

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  authProviderId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses Business[]
}

model Business {
  id                    String   @id @default(cuid())
  ownerId               String
  name                  String
  description           String?
  phone                 String?
  website               String?
  address               String?
  timezone              String   @default("Asia/Kolkata")
  callingEnabled        Boolean  @default(true)
  followUpCallingEnabled Boolean @default(true)
  callingWindowStart    String   @default("09:00")
  callingWindowEnd      String   @default("20:00")
  /// Comma-separated ISO weekdays: 1=Mon … 7=Sun
  callingDays           String   @default("1,2,3,4,5,6")
  maxFollowUpAttempts   Int      @default(3)
  /// Short lease serializing queued call starts so the concurrency limit holds
  callQueueLockedUntil  DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledge          BusinessKnowledge[]
  agents             Agent[]
  leads              Lead[]
  calls              Call[]
  appointments       Appointment[]
  campaigns          Campaign[]
  subscriptions      Subscription[]
  followUps          FollowUp[]

  @@index([ownerId])
}

model BusinessKnowledge {
  id         String   @id @default(cuid())
  businessId String
  category   String
  title      String
  content    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, category])
  @@index([businessId, active])
}

model Agent {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  language     AgentLanguage @default(HINGLISH)
  voice        String?
  systemPrompt String?
  objective    String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls        Call[]
  campaigns    Campaign[]
  followUps    FollowUp[]
  appointments Appointment[]

  @@index([businessId])
  @@index([businessId, active])
}

model Lead {
  id               String     @id @default(cuid())
  businessId       String
  name             String
  phone            String
  email            String?
  status           LeadStatus @default(NEW)
  source           String?
  notes            String?
  company          String?
  assignedTo       String?
  followUpRequired Boolean    @default(false)
  followUpAt       DateTime?
  followUpNote     String?
  followUpReminder Boolean    @default(false)
  /// Customer asked not to be called again; blocks all outbound calls
  doNotCall        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls         Call[]
  appointments  Appointment[]
  campaignLeads CampaignLead[]
  followUps     FollowUp[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, phone])
}

model Call {
  id               String     @id @default(cuid())
  businessId       String
  leadId           String
  agentId          String
  provider         String     @default("vapi")
  providerCallId   String?
  status           CallStatus @default(QUEUED)
  duration         Int?
  recordingUrl     String?
  transcript       String?
  summary          String?
  errorMessage     String?
  endedReason      String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime   @default(now())
  /// Follow-up job that triggered this outbound call (if any)
  sourceFollowUpId String?
  /// Campaign lead that triggered this outbound call (if any)
  campaignLeadId   String?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent    Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  result   CallResult?
  appointments Appointment[]
  followUpsAsSource FollowUp[] @relation("FollowUpSourceCall")
  sourceFollowUp    FollowUp?  @relation("FollowUpOutboundCall", fields: [sourceFollowUpId], references: [id], onDelete: SetNull)
  campaignLead      CampaignLead? @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)

  @@unique([provider, providerCallId])
  @@index([businessId])
  @@index([leadId])
  @@index([agentId])
  @@index([businessId, status])
  @@index([sourceFollowUpId])
  @@index([campaignLeadId])
}

model CallResult {
  id               String   @id @default(cuid())
  callId           String   @unique
  interest         String?
  requirement      String?
  followUpRequired Boolean  @default(false)
  followUpDate     DateTime?
  customerSentiment String?
  summary          String?
  customerName     String?
  course           String?
  /// Objections the customer raised, as a JSON string ("; "-separated). Older rows may hold an array.
  objections       Json?
  summaryStatus    CallSummaryStatus?
  summaryUpdatedAt DateTime?
  createdAt        DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
}

enum CallSummaryStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

model Appointment {
  id         String            @id @default(cuid())
  businessId String
  leadId     String
  callId     String?
  /// AI agent that booked it, if booked during a call
  agentId    String?
  /// Start instant. Rows created before slot booking hold only the day, with `time` separate.
  date       DateTime
  /// Start time "HH:mm" in the business timezone
  time       String?
  endAt      DateTime?
  type       String?
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  /// "businessId|startISO" while the appointment holds its slot; cleared when cancelled
  slotKey    String?           @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call     Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([leadId])
  @@index([callId])
  @@index([agentId])
  @@index([businessId, date])
}

model Campaign {
  id         String         @id @default(cuid())
  businessId String
  agentId    String
  name       String
  status     CampaignStatus @default(DRAFT)
  startTime  DateTime?
  endTime    DateTime?
  /// Comma-separated ISO weekdays: 1=Mon … 7=Sun (timezone = Business.timezone)
  callingDays        String   @default("1,2,3,4,5,6")
  callingWindowStart String   @default("09:00")
  callingWindowEnd   String   @default("20:00")
  maxAttempts        Int      @default(3)
  /// Wait before retrying a no-answer or voicemail call
  retryDelayMinutes  Int      @default(60)
  busyRetryMinutes   Int      @default(30)
  failedRetryMinutes Int      @default(30)
  retryOnVoicemail   Boolean  @default(true)
  /// Create follow-up jobs when a customer asks to be called back
  createFollowUps    Boolean  @default(true)
  failureReason      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leads    CampaignLead[]

  @@index([businessId])
  @@index([agentId])
  @@index([businessId, status])
  @@index([status])
}

model CampaignLead {
  id            String             @id @default(cuid())
  campaignId    String
  leadId        String
  status        CampaignLeadStatus @default(PENDING)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  /// CONNECTED | BUSY | NO_ANSWER | VOICEMAIL | FAILED | REFUSED | OPTED_OUT | MAX_ATTEMPTS | INELIGIBLE
  lastOutcome   String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
  @@index([campaignId, status])
}

model FollowUp {
  id             String         @id @default(cuid())
  businessId     String
  leadId         String
  agentId        String?
  /// Call that requested this follow-up
  callId         String?
  scheduledAt    DateTime
  status         FollowUpStatus @default(PENDING)
  reason         String?
  skipReason     String?
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sourceCall Call?  @relation("FollowUpSourceCall", fields: [callId], references: [id], onDelete: SetNull)
  outboundCalls Call[] @relation("FollowUpOutboundCall")

  @@index([businessId, status, scheduledAt])
  @@index([leadId, status])
  @@index([scheduledAt, status])
  @@index([callId])
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String
  plan                   String
  status                 SubscriptionStatus @default(TRIALING)
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, status])
  @@index([providerCustomerId])
}
